# Системные файлы (Обязательно)
.DS_Store
Thumbs.db

# Настройки сред разработки / IDE (Обязательно)
.vscode/
.idea/

# Виртуальные окружения Python (Обязательно)
venv/
.venv/
env/
.env

# Кэш Python и скомпилированные файлы (Обязательно)
__pycache__/
*.pyc
*.pyo
*.pyd

# Стандартные файлы для Python (Дополнительно)
*.log
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Стандартные файлы для Web / Frontend (Дополнительно)
node_modules/
/dist/
.env.local
.env.development.local
.env.test.local
.env.production.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*